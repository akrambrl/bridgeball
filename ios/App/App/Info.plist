<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>GOAT FC</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<!-- ══ ADMOB : SANS CETTE CLÉ, L'APP PLANTE AU LANCEMENT ══════════════════
	     Le SDK Google Mobile Ads lève une exception au démarrage si
	     GADApplicationIdentifier est absent ou mal formé — avant le premier
	     écran, sur tous les iPhone. C'est l'exact pendant du meta-data
	     com.google.android.gms.ads.APPLICATION_ID côté Android.

	     C'est ici l'identifiant d'APPLICATION (avec un ~), PAS celui du bloc
	     d'annonces (avec un /) : intervertir les deux redonne le même plantage.

	     Valeur actuelle = l'identifiant de TEST public de Google pour iOS.
	     À remplacer par celui de l'app iOS créée dans AdMob au moment de la
	     mise en production, et pas avant : un clic sur sa propre vraie
	     publicité fait fermer un compte AdMob définitivement.
	     https://developers.google.com/admob/ios/test-ads -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3940256099942544~1458002511</string>
	<!-- ══ APP TRACKING TRANSPARENCY ══════════════════════════════════════════
	     Demander l'autorisation SANS cette phrase fait planter l'app : iOS
	     l'exige pour afficher la fenêtre. Elle est donc aussi obligatoire que
	     la clé au-dessus, simplement pour une autre raison.

	     Le texte est en anglais parce que CFBundleDevelopmentRegion vaut `en`,
	     donc c'est la langue de repli du bundle. Le traduire demande un
	     fr.lproj/InfoPlist.strings ajouté aux ressources du projet Xcode —
	     à faire depuis Xcode, pas à la main dans le .xcodeproj. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>GOAT FC uses this to show you rewarded ads that fit your interests. Decline and you keep every feature — the ads are simply less relevant.</string>
	<!-- ══ CHIFFREMENT À L'EXPORT : LA QUESTION QU'ON NE VEUT PLUS VOIR ═══════
	     Sans cette clé, App Store Connect pose à CHAQUE build téléversé la
	     question « votre app utilise-t-elle un chiffrement ? », et le build reste
	     bloqué en attente tant qu'on n'y a pas répondu à la main. Sur un projet
	     qui déploie par workflow, c'est une intervention manuelle imposée à
	     chaque fois — et un build qu'on croit disponible alors qu'il attend.

	     `false` signifie : l'app n'utilise AUCUN chiffrement non exempté. C'est
	     vérifié, pas supposé :

	       • aucune bibliothèque de chiffrement dans les dépendances — ni forge,
	         ni tweetnacl, ni sodium, ni bcrypt, rien ;
	       • aucun algorithme maison : le seul appel à `crypto` du projet est
	         `crypto.randomUUID()`, qui fabrique un identifiant aléatoire. Générer
	         un UUID n'est pas chiffrer ;
	       • tout le réseau passe en HTTPS/TLS, c'est-à-dire le chiffrement FOURNI
	         PAR iOS. C'est exactement le cas exempté par la réglementation, et la
	         raison pour laquelle la réponse honnête est « non ».

	     À rouvrir si l'app se met un jour à chiffrer elle-même quelque chose —
	     par exemple à stocker des données chiffrées avec sa propre clé. Dans ce
	     cas la valeur passe à `true` et une déclaration d'exportation devient
	     obligatoire.
	     https://developer.apple.com/documentation/security/complying_with_encryption_export_regulations -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
